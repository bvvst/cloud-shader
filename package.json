{
  "name": "cloud-shader",
  "version": "0.1.0",
  "description": "An animated WebGL sky background: drifting clouds by day, wheeling stars by night. Zero dependencies, with an optional React component.",
  "keywords": [
    "webgl",
    "shader",
    "glsl",
    "background",
    "clouds",
    "sky",
    "stars",
    "hero",
    "react",
    "animation"
  ],
  "license": "MIT",
  "author": "luke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvvst/cloud-shader.git"
  },
  "homepage": "https://github.com/bvvst/cloud-shader#readme",
  "bugs": {
    "url": "https://github.com/bvvst/cloud-shader/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "vite demo",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "packageManager": "pnpm@12.16.1"
}
